<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly collection on macOS. Install (see README):
    sed "s|__REPO__|$PWD|" scripts/tw.twmedia.collect.plist > ~/Library/LaunchAgents/tw.twmedia.collect.plist
    launchctl load ~/Library/LaunchAgents/tw.twmedia.collect.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tw.twmedia.collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/collect.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/tw.twmedia.collect.err</string>
</dict>
</plist>
